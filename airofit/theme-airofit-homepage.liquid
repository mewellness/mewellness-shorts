              {%- else -%}
                <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="rgba(17,17,17,0.3)" stroke-width="1.25"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              {%- endif -%}
              {%- if product.tags contains 'best-seller' -%}
                <span class="af-product-card__badge">Best Seller</span>
              {%- endif -%}
            </div>
            <div class="af-product-card__body">
              <div class="af-product-card__cat">{{ product.type }}</div>
              <div class="af-product-card__name">{{ product.title }}</div>
              <div class="af-product-card__desc">{{ product.description | strip_html | truncate: 100 }}</div>
              <div class="af-product-card__footer">
                <span class="af-product-card__price">{{ product.price | money }}</span>
                <span class="af-product-card__cta">Add to cart</span>
              </div>
            </div>
          </a>
        {%- endfor -%}
