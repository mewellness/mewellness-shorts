        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ====== FULL-WIDTH BANNER ====== {%- endcomment -%}
  <section style="padding:48px 0 0;">
    <div class="af-container">
      <img
        class="af-banner-img"
        src="https://airofit.com/cdn/shop/files/1_6c8cb071-f658-4603-ad99-131233212dc0_2000x.png?v=1750825596"
        alt="Airofit breathing trainer Australia"
