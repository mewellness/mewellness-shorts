    </div>
  </section>

  {%- comment -%} ====== FEATURE ROWS WITH REAL IMAGES ====== {%- endcomment -%}
  <section class="af-features">
    <div class="af-container">

      <div class="af-feature-row">
        <div class="af-feature-row__visual" style="padding:0;overflow:hidden;">
