{{ 'airofit-design.css' | asset_url | stylesheet_tag }}

<style>
.af-feature-img { width: 100%; height: 100%; object-fit: cover; display: block; }
.af-banner-img { width: 100%; border-radius: 20px; object-fit: cover; height: 280px; display: block; }
.af-science-img { width: 100%; border-radius: 20px; object-fit: cover; max-height: 460px; display: block; margin: 40px auto 0; }
@media (min-width: 768px) { .af-banner-img { height: 460px; } }
.af-benefit-card__icon svg { width: 28px; height: 28px; stroke: var(--af-teal); stroke-width: 1.75; fill: none; }

/* ---- HERO SLIDER (airofit.com style) ---- */
.af-hero2 { position: relative; overflow: hidden; background: #0d0d0d; color: #fff; }
.af-hero2__slides { display: grid; }
.af-hero2__slide { grid-area: 1 / 1; position: relative; display: flex; align-items: center; min-height: 560px; opacity: 0; visibility: hidden; transition: opacity .7s ease, visibility 0s linear .7s; }
.af-hero2__slide.is-active { opacity: 1; visibility: visible; transition: opacity .7s ease; z-index: 1; }
.af-hero2__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.af-hero2__overlay { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.6) 50%, rgba(0,0,0,0.2) 100%); }
.af-hero2__inner { position: relative; z-index: 1; width: 100%; padding-top: 72px; padding-bottom: 72px; }
.af-hero2__content { max-width: 600px; }
.af-hero2__cobrand { display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.14); backdrop-filter: blur(6px); border: 1px solid rgba(255,255,255,0.25); border-radius: 9999px; padding: 6px 14px; font-size: 12px; font-weight: 600; letter-spacing: 0.02em; color: #fff; margin-bottom: 22px; }
.af-hero2__cobrand-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--af-teal); }
.af-page .af-hero2__title { font-size: clamp(38px, 5.6vw, 76px); font-weight: 900; font-style: italic; text-transform: uppercase; letter-spacing: -0.01em; line-height: 0.95; color: #fff; margin: 0 0 22px; text-wrap: balance; }
.af-hero2__sub { font-size: 17px; line-height: 1.6; color: rgba(255,255,255,0.9); max-width: 520px; margin: 0 0 30px; }
.af-hero2__ctas { display: flex; flex-wrap: wrap; gap: 12px; }
.af-hero2__btn { display: inline-flex; align-items: center; justify-content: center; min-width: 150px; padding: 14px 28px; border-radius: 9999px; font-family: var(--af-font); font-size: 15px; font-weight: 700; text-decoration: none; transition: background .2s, color .2s, border-color .2s; }
.af-hero2__btn--solid { background: #fff; color: #111; border: 2px solid #fff; }
.af-hero2__btn--solid:hover { background: var(--af-teal); border-color: var(--af-teal); color: #fff; }
.af-hero2__btn--ghost { background: transparent; color: #fff; border: 2px solid rgba(255,255,255,0.85); }
.af-hero2__btn--ghost:hover { background: #fff; color: #111; }
.af-hero2__bottom { position: relative; z-index: 2; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; padding-top: 22px; padding-bottom: 26px; border-top: 1px solid rgba(255,255,255,0.15); background: #0d0d0d; }
.af-hero2__stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); flex: 1 1 420px; max-width: 640px; }
.af-hero2__stat { padding-right: 12px; min-width: 0; }
.af-hero2__stat + .af-hero2__stat { border-left: 1px solid rgba(255,255,255,0.25); padding-left: 16px; }
.af-hero2__stat-val { font-size: clamp(20px, 2.6vw, 30px); font-weight: 900; font-style: italic; text-transform: uppercase; line-height: 1; color: #fff; }
.af-hero2__stat-label { font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.75); margin-top: 6px; }
.af-hero2__controls { display: flex; align-items: center; gap: 14px; }
.af-hero2__arrow { width: 44px; height: 44px; border-radius: 50%; border: 1.5px solid rgba(255,255,255,0.6); background: transparent; color: #fff; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; transition: background .2s, color .2s; }
.af-hero2__arrow:hover { background: #fff; color: #111; }
.af-hero2__dots { display: flex; gap: 8px; }
.af-hero2__dot { width: 9px; height: 9px; padding: 0; border-radius: 9999px; border: 0; background: rgba(255,255,255,0.45); cursor: pointer; transition: width .3s, background .3s; }
.af-hero2__dot.is-active { width: 28px; background: #fff; }
.af-hero2__arrow:focus-visible, .af-hero2__dot:focus-visible, .af-hero2__btn:focus-visible { outline: 2px solid var(--af-teal); outline-offset: 3px; }
@media (min-width: 768px) {
  .af-hero2__slide { min-height: 640px; }
  .af-hero2__inner { padding-top: 96px; padding-bottom: 96px; }
}
@media (max-width: 767px) {
  .af-hero2__slide { min-height: 520px; align-items: flex-end; }
  .af-hero2__overlay { background: linear-gradient(180deg, rgba(0,0,0,0.45) 0%, rgba(0,0,0,0.85) 70%); }
  .af-hero2__inner { padding-top: 48px; padding-bottom: 40px; }
  .af-hero2__sub { font-size: 15px; }
  .af-hero2__btn { flex: 1 1 140px; }
  .af-hero2__stat-label { font-size: 10px; letter-spacing: 0.08em; }
  .af-hero2__controls { width: 100%; justify-content: center; }
}
@media (prefers-reduced-motion: reduce) { .af-hero2__slide, .af-hero2__dot { transition: none; } }

/* ---- MEWELLNESS CO-BRAND STRIP ---- */
.af-cobrand { background: var(--af-teal-soft); border-bottom: 1px solid var(--af-border); padding: 22px 0; }
.af-cobrand__inner { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 28px; }
.af-cobrand__brand { display: inline-flex; align-items: baseline; gap: 8px; font-weight: 800; font-size: 18px; letter-spacing: -0.01em; white-space: nowrap; }
.af-cobrand__x { color: var(--af-ink); }
.af-cobrand__times { color: var(--af-muted); font-weight: 500; }
.af-cobrand__mw { color: var(--af-teal-dark); }
.af-cobrand__text { flex: 1 1 380px; margin: 0; font-size: 14px; line-height: 1.55; color: #2d3a35; }
.af-cobrand__link { font-size: 13px; font-weight: 700; color: var(--af-teal-dark); text-decoration: none; white-space: nowrap; }
.af-cobrand__link:hover { color: var(--af-ink); }
</style>

<div class="af-page">

  {%- comment -%} ====== HERO SLIDER (matches airofit.com) ====== {%- endcomment -%}
  <section class="af-hero2" id="af-hero-{{ section.id }}" aria-roledescription="carousel" aria-label="Featured">
    <div class="af-hero2__slides">
      {%- for block in section.blocks -%}
        {%- if block.settings.image != blank -%}
          {%- capture slide_img -%}{{ block.settings.image | image_url: width: 2000 }}{%- endcapture -%}
        {%- else -%}
          {%- assign slide_img = block.settings.image_url -%}
        {%- endif -%}
        <div class="af-hero2__slide{% if forloop.first %} is-active{% endif %}" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ section.blocks.size }}" {% unless forloop.first %}aria-hidden="true"{% endunless %} {{ block.shopify_attributes }}>
          <img class="af-hero2__bg" src="{{ slide_img }}" alt="{{ block.settings.title | escape }}" {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %} style="object-position: {{ block.settings.focus | default: 'center' }};">
          <div class="af-hero2__overlay"></div>
          <div class="af-container af-hero2__inner">
            <div class="af-hero2__content">
              <span class="af-hero2__cobrand">
                <span class="af-hero2__cobrand-dot"></span>
                {{ section.settings.hero_badge | default: 'Airofit Australia · Run by MeWellness' }}
              </span>
              {%- if forloop.first -%}
                <h1 class="af-hero2__title">{{ block.settings.title }}</h1>
              {%- else -%}
                <h2 class="af-hero2__title">{{ block.settings.title }}</h2>
              {%- endif -%}
              <p class="af-hero2__sub">{{ block.settings.subtitle }}</p>
              <div class="af-hero2__ctas">
                {%- if block.settings.cta_primary != blank -%}
                  <a href="{{ block.settings.cta_primary_link | default: '/collections/all' }}" class="af-hero2__btn af-hero2__btn--solid" {% unless forloop.first %}tabindex="-1"{% endunless %}>{{ block.settings.cta_primary }}</a>
                {%- endif -%}
                {%- if block.settings.cta_secondary != blank -%}
                  <a href="{{ block.settings.cta_secondary_link | default: '#af-science' }}" class="af-hero2__btn af-hero2__btn--ghost" {% unless forloop.first %}tabindex="-1"{% endunless %}>{{ block.settings.cta_secondary }}</a>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    <div class="af-container af-hero2__bottom">
      <div class="af-hero2__stats">
        <div class="af-hero2__stat"><div class="af-hero2__stat-val">30%</div><div class="af-hero2__stat-label">In lung capacity</div></div>
        <div class="af-hero2__stat"><div class="af-hero2__stat-val">3–4 Weeks</div><div class="af-hero2__stat-label">Time to results</div></div>
        <div class="af-hero2__stat"><div class="af-hero2__stat-val">5 Min</div><div class="af-hero2__stat-label">Training per day</div></div>
      </div>
      {%- if section.blocks.size > 1 -%}
      <div class="af-hero2__controls">
        <button type="button" class="af-hero2__arrow" data-dir="-1" aria-label="Previous slide">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <div class="af-hero2__dots">
          {%- for block in section.blocks -%}
            <button type="button" class="af-hero2__dot{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
          {%- endfor -%}
        </div>
        <button type="button" class="af-hero2__arrow" data-dir="1" aria-label="Next slide">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
      {%- endif -%}
    </div>
  </section>

  <script>
  (function () {
    var root = document.getElementById('af-hero-{{ section.id }}');
    if (!root) return;
    var slides = root.querySelectorAll('.af-hero2__slide');
    var dots = root.querySelectorAll('.af-hero2__dot');
    if (slides.length < 2) return;
    var i = 0, timer = null, delay = {{ section.settings.autoplay_seconds | default: 6 | times: 1000 }};
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function go(n) {
      i = (n + slides.length) % slides.length;
      slides.forEach(function (s, k) {
        var on = k === i;
        s.classList.toggle('is-active', on);
        if (on) { s.removeAttribute('aria-hidden'); } else { s.setAttribute('aria-hidden', 'true'); }
        s.querySelectorAll('a').forEach(function (a) { if (on) { a.removeAttribute('tabindex'); } else { a.setAttribute('tabindex', '-1'); } });
        var img = s.querySelector('img');
        if (on && img && img.loading === 'lazy') img.loading = 'eager';
      });
      dots.forEach(function (d, k) { d.classList.toggle('is-active', k === i); });
    }
    function start() { if (!reduce && {{ section.settings.autoplay | json }}) { stop(); timer = setInterval(function () { go(i + 1); }, delay); } }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }
    root.querySelectorAll('.af-hero2__arrow').forEach(function (b) { b.addEventListener('click', function () { go(i + Number(b.dataset.dir)); start(); }); });
    dots.forEach(function (d) { d.addEventListener('click', function () { go(Number(d.dataset.index)); start(); }); });
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    var x0 = null;
    root.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; stop(); }, { passive: true });
    root.addEventListener('touchend', function (e) {
      if (x0 === null) return;
      var dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) go(i + (dx < 0 ? 1 : -1));
      x0 = null; start();
    });
    document.addEventListener('shopify:block:select', function (e) {
      var idx = Array.prototype.indexOf.call(slides, e.target);
      if (idx > -1) { stop(); go(idx); }
    });
    start();
  })();
  </script>

