    </div>
  </section>

  {%- comment -%} ====== SCIENCE ====== {%- endcomment -%}
  <section class="af-science" id="af-science">
    <div class="af-container">
      <div class="af-science__eyebrow">The Science</div>
      <h2 class="af-science__title">Backed by research. Built for Aussies.</h2>
      <p class="af-science__sub">Airofit's methodology is grounded in peer-reviewed studies on respiratory muscle training — trusted by 180,000+ athletes worldwide.</p>
      <div class="af-science-stats">
        <div class="af-science-stat">
          <div class="af-science-stat__val">+40%</div>
          <div class="af-science-stat__label">stronger breathing muscles after 4 weeks</div>
        </div>
        <div class="af-science-stat">
          <div class="af-science-stat__val">20+</div>
          <div class="af-science-stat__label">peer-reviewed studies</div>
        </div>
        <div class="af-science-stat">
          <div class="af-science-stat__val">10 min</div>
          <div class="af-science-stat__label">per day, all you need</div>
        </div>
      </div>
      <img
        class="af-science-img"
        src="https://cdn.shopify.com/s/files/1/0082/8309/5117/files/24_826474d4-bcad-4d15-bda3-610467ce2f9c.jpg?v=1777579182&width=1400"
        alt="Airofit science — backed by research, built for Australians"
        loading="lazy"
      >
    </div>
  </section>

  {%- comment -%} ====== ACCESSORIES ====== {%- endcomment -%}
  <section class="af-products">
    <div class="af-container">
      <div class="af-section-header">
        <div>
          <h2 class="af-section-title">Accessories</h2>
          <p class="af-section-sub">Make the most of your kit.</p>
        </div>
        <a href="/collections/accessories" class="af-section-link">Shop accessories →</a>
      </div>
      <div class="af-product-grid">
        {%- for product in collections['accessories'].products limit: 3 -%}
          <a href="{{ product.url }}" class="af-product-card">
            <div class="af-product-card__img">
              {%- if product.featured_image -%}
                <img src="{{ product.featured_image | img_url: '600x600' }}" alt="{{ product.title | escape }}" loading="lazy">
              {%- else -%}
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="rgba(17,17,17,0.3)" stroke-width="1.25"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
              {%- endif -%}
            </div>
            <div class="af-product-card__body">
              <div class="af-product-card__cat">{{ product.type }}</div>
              <div class="af-product-card__name">{{ product.title }}</div>
              <div class="af-product-card__desc">{{ product.description | strip_html | truncate: 100 }}</div>
              <div class="af-product-card__footer">
                <span class="af-product-card__price">{{ product.price | money }}</span>
                <span class="af-product-card__cta">Add to cart</span>
              </div>
            </div>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ====== FAQs + CONTACT ====== {%- endcomment -%}
  <section class="af-faqs" id="af-faqs">
    <div class="af-container">
      <div class="af-faqs__grid">
        <div>
          <h2 class="af-section-title">Questions?</h2>
          <p class="af-section-sub" style="margin-top:12px">Everything you need to know before you start. Our MeWellness team in Sydney is here to help.</p>
          <div style="margin-top:24px;display:flex;flex-direction:column;gap:12px;">
            <a href="tel:0470645648" style="display:inline-flex;align-items:center;gap:10px;font-size:14px;font-weight:600;color:var(--af-ink);text-decoration:none;">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--af-teal)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.64a16 16 0 0 0 5.45 5.45l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              Call Us: 0470 645 648
            </a>
            <a href="mailto:sales@mewellness.com.au" style="display:inline-flex;align-items:center;gap:10px;font-size:14px;font-weight:600;color:var(--af-ink);text-decoration:none;">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--af-teal)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              Email Us: sales@mewellness.com.au
            </a>
          </div>
        </div>
        <div>
          {%- assign faqs = 'How long until I see results?|Is Airofit safe for asthma or COPD?|Do I need the app to use the device?|How does the 30-day money-back guarantee work?' | split: '|' -%}
          {%- for faq in faqs -%}
            <div class="af-faq-item">
              <svg class="af-faq-check" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <span class="af-faq-q">{{ faq }}</span>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>

</div>

{% schema %}
{
  "name": "Airofit Homepage",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Hero slider" },
    { "type": "text", "id": "hero_badge", "label": "Badge text (all slides)", "default": "Airofit Australia · Run by MeWellness" },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": true },
    { "type": "range", "id": "autoplay_seconds", "label": "Seconds per slide", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 6 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Hero slide",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background image" },
        { "type": "text", "id": "image_url", "label": "Or background image URL", "info": "Used when no image is picked above." },
        { "type": "select", "id": "focus", "label": "Image focus", "default": "center", "options": [
          { "value": "left center", "label": "Left" },
          { "value": "center", "label": "Centre" },
          { "value": "right center", "label": "Right" }
        ] },
        { "type": "text", "id": "title", "label": "Headline", "default": "Train the muscles most ignore" },
        { "type": "textarea", "id": "subtitle", "label": "Subheading" },
        { "type": "text", "id": "cta_primary", "label": "Primary button text", "default": "Shop now" },
        { "type": "url", "id": "cta_primary_link", "label": "Primary button link" },
        { "type": "text", "id": "cta_secondary", "label": "Secondary button text", "default": "Learn more" },
        { "type": "url", "id": "cta_secondary_link", "label": "Secondary button link" }
      ]
    }
  ],
  "presets": [{ "name": "Airofit Homepage" }]
}
{% endschema %}
