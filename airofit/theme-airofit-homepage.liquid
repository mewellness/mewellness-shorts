  {%- comment -%} ====== PRODUCTS ====== {%- endcomment -%}
  <section class="af-products">
    <div class="af-container">
      <div class="af-section-header">
        <div>
          <h2 class="af-section-title">Shop Airofit Breathing Trainers</h2>
          <p class="af-section-sub">Two breathing trainers, one goal: stronger breathing muscles in about 10 minutes a day.</p>
